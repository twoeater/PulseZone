ZONE_PATH=./zones
ZONE_REFRESH_TIME=3600
CHECK_INTERVAL=10
TIMEOUT=10
RETRY=10
RETRY_DELAY=10
ALERT_SLACK=
ALERT_DISCORD=
ALERT_NTFY=
ALERT_GOTIFY=
ALERT_CUSTOM=
ALERT_GOTIFY_TOKEN=
# ntfy auth: empty -> no auth; contains ':' -> username:password; otherwise -> :token
ALERT_NTFY_TOKEN=
DATABASE_PATH=./data/pulsezone.sqlite3
WEB_HOST=0.0.0.0
WEB_PORT=8080
CHECK_PROTOCOL=auto
HTTPS_INSECURE=false
HTTP_ALLOW_2XX=true
HTTP_ALLOW_3XX=true
HTTP_ALLOW_4XX=false
HTTP_ALLOW_5XX=false
MAINTENANCE=false
MAX_CONCURRENCY=100
HISTORY_SIZE=60
